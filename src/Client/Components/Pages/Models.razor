@page "/models"

@using AGUIWebChat.Contracts.AI
@using AGUIWebChat.Contracts.AI.Models
@using AGUIWebChat.Client.Services.AI
@using AGUIWebChat.Client.Components.AI
@using Microsoft.FluentUI.AspNetCore.Components

@inject AIModelApiClient ModelApiClient
@inject AIProviderApiClient ProviderApiClient
@inject IDialogService DialogService

<PageTitle>AI Models</PageTitle>

<h1>AI Models</h1>

<p>Manage the AI models available to agents.</p>

@if (_loading)
{
    <FluentSpinner />
}
else if (_errorMessage is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error">
        @_errorMessage
    </FluentMessageBar>
}
else
{
    <FluentStack Orientation="Orientation.Horizontal"
                 HorizontalAlignment="HorizontalAlignment.End">

        <FluentButton Appearance="ButtonAppearance.Primary"
                      IconStart="@(new Icons.Regular.Size20.Add())"
                      OnClick="AddModelAsync">
            Add a model
        </FluentButton>

    </FluentStack>

    <FluentDataGrid TGridItem="AIModelEditModel"
                    Items="@_models.AsQueryable()"
                    ShowHover="true"
                    ReorderableColumns="true"
                    HeaderCellAsButtonWithMenu="true"
                    ResizableColumns="true">

        <PropertyColumn Property="@(x => x.ProviderName)" Title="Provider" />
        <PropertyColumn Property="@(x => x.DisplayName)" Title="Model" />
        <PropertyColumn Property="@(x => x.ModelId)" Title="Model ID" />
        <PropertyColumn Property="@(x => x.ThinkingMode)" Title="Thinking" />
        <PropertyColumn Property="@(x => x.ContextWindow)" Title="Context" />

        <TemplateColumn Title="Enabled">
            <ChildContent>
                @if (context.IsEnabled)
                {
                    <FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkCircle())" />
                }
                else
                {
                    <FluentIcon Value="@(new Icons.Regular.Size20.DismissCircle())" />
                }
            </ChildContent>
        </TemplateColumn>

        <TemplateColumn Title="Actions">
            <ChildContent>
                <FluentButton Appearance="ButtonAppearance.Primary"
                              IconStart="@(new Icons.Regular.Size20.Edit())"
                              Title="Edit"
                              OnClick="@(() => EditModelAsync(context))">
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default"
                              IconStart="@(new Icons.Regular.Size20.Delete())"
                              Title="Delete"
                              OnClick="@(() => DeleteModelAsync(context))">
                </FluentButton>
            </ChildContent>
        </TemplateColumn>
    </FluentDataGrid>
}

@code
{
    private IReadOnlyList<AIModelEditModel> _models = [];

    private bool _loading = true;

    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadModelsAsync();
    }

    private async Task LoadModelsAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            _models = await ModelApiClient.GetModelsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to load AI models: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddModelAsync()
    {
        _errorMessage = null;

        try
        {
            var providers = await ProviderApiClient.GetProvidersAsync();

            if (providers.Count == 0)
            {
                _errorMessage = "No active AI provider is available.";

                return;
            }

            var newModel = new AIModelEditModel
            {
                IsEnabled = true,
                ThinkingMode = ThinkingMode.None
            };

            var result = await DialogService.ShowDrawerAsync<AIModelEditor>(options =>
            {
                options.Modal = true;
                options.Alignment = DialogAlignment.End;
                options.Parameters.Add(nameof(AIModelEditor.Model), newModel);
                options.Parameters.Add(nameof(AIModelEditor.IsNew), true);
                options.Parameters.Add(nameof(AIModelEditor.Providers), providers);
                options.Footer.PrimaryAction.Label = "Add";
                options.Footer.SecondaryAction.Label = "Cancel";
            });

            if (result.Cancelled)
                return;

            await ModelApiClient.CreateAsync(newModel);

            await LoadModelsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to create AI model: {ex.Message}";
        }
    }

    private async Task EditModelAsync(AIModelEditModel model)
    {
        _errorMessage = null;

        try
        {
            var currentModel = await ModelApiClient.GetModelAsync(model.Id);

            if (currentModel is null)
            {
                _errorMessage = $"The model {model.DisplayName} no longer exists.";

                return;
            }

            var result = await DialogService.ShowDrawerAsync<AIModelEditor>(options =>
            {
                options.Modal = true;

                options.Alignment = DialogAlignment.End;

                options.Parameters.Add(nameof(AIModelEditor.Model), currentModel);

                options.Footer.PrimaryAction.Label = "Save";

                options.Footer.SecondaryAction.Label = "Cancel";
            });

            if (result.Cancelled)
                return;

            await ModelApiClient.UpdateAsync(currentModel);

            await LoadModelsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to update AI model: {ex.Message}";
        }
    }

    private async Task DeleteModelAsync(AIModelEditModel model)
    {
        _errorMessage = null;

        var result = await DialogService.ShowConfirmationAsync(
            $"Do you really want to delete the model « {model.DisplayName} » ?",
            "Deleting an AI model", 
            "Deletion Confirmation",
            "Cancel");

        if (result.Cancelled)
            return;

        try
        {
            await ModelApiClient.DeleteAsync(model.Id);

            await LoadModelsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to delete AI model: {ex.Message}";
        }
    }
}