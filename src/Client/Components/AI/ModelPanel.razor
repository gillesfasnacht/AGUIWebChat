@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using AGUIWebChat.Contracts.AI
@using AGUIWebChat.Contracts.AI.Models
@using AGUIWebChat.Contracts.AI.Providers
@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" HorizontalAlignment="HorizontalAlignment.Stretch">
        <EditForm EditContext="@_editContext" OnSubmit="SubmitAsync" novalidate="true">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <FluentDivider />

            @* Model *@
            <h4 class="brand-text">Model</h4>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
                @if (IsNew)
                {
                    <FluentSelect TOption="AIProviderListItem"
                                  TValue="int"
                                  Label="Provider"
                                  Items="@Providers"
                                  OptionText="@(provider => provider.Name)"
                                  OptionValue="@(provider => provider.Id)"
                                  @bind-Value="Model.ProviderId"
                                  @bind-Value:after="ProviderChanged" />
                }
                else
                {
                    <FluentTextInput Label="Provider"
                                     Value="@Model.ProviderName"
                                     ReadOnly="true" />
                }
                <FluentTextInput Label="Model ID"
                                 @bind-Value="Model.ModelId" />
                <FluentTextInput Label="Display name"
                                 @bind-Value="Model.DisplayName" />
            </FluentStack>

            @* Capabilities *@
            <h4 class="brand-text">Capabilities</h4>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
                <FluentCheckbox Shape="@CheckboxShape.Circular"
                                Label="Tools"
                                @bind-Value="Model.SupportsTools">
                </FluentCheckbox>
                <FluentCheckbox Shape="@CheckboxShape.Circular"
                                Label="Streaming"
                                @bind-Value="Model.SupportsStreaming">
                </FluentCheckbox>
                <FluentCheckbox Shape="@CheckboxShape.Circular"
                                Label="Vision"
                                @bind-Value="Model.SupportsVision">
                </FluentCheckbox>
            </FluentStack>

            @* Reasoning *@
            <h4 class="brand-text">Reasoning</h4>
            <FluentStack Orientation="Orientation.Vertical">
                <FluentSelect Label="Thinking mode"
                              Items="@_thinkingModes"
                              @bind-Value="Model.ThinkingMode" />
            </FluentStack>
            @if (Model.ThinkingMode == ThinkingMode.Effort)
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                    <FluentLabel Typo="Typography.Body">
                        Reasoning efforts
                    </FluentLabel>
                    @if (!IsReasoningValid())
                    {
                        <FluentMessageBar Intent="MessageBarIntent.Warning">
                            Add at least one effort level, fill in its name and value, and select exactly one default level.
                        </FluentMessageBar>
                    }
                    @foreach (var effort in Model.ReasoningEfforts.OrderBy(x => x.SortOrder).ToList())
                    {
                        <div @key="effort">

                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12"
                                         VerticalAlignment="VerticalAlignment.Center">
                                    <FluentTextInput Label="Name"
                                                     @bind-Value="effort.DisplayName" />
                                    <FluentTextInput Label="Value"
                                                     @bind-Value="effort.Value" />
                                    <FluentNumberInput Label="Order"
                                                       @bind-Value="effort.SortOrder" />
                                <FluentCheckbox Value="@effort.IsDefault"
                                                ValueExpression="@(() => effort.IsDefault)"
                                                ValueChanged="@((bool value) => SetDefaultEffort(effort, value))">
                                    Default
                                </FluentCheckbox>
                                <FluentButton Appearance="ButtonAppearance.Primary"
                                              IconStart="@(new Icons.Regular.Size20.Delete())"
                                              Type="ButtonType.Button"
                                              OnClick="@(() => RemoveEffort(effort))" />
                            </FluentStack>
                        </div>
                    }
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  IconStart="@(new Icons.Regular.Size20.Add())"
                                  Type="ButtonType.Button"
                                  OnClick="AddEffort">
                        Add a level
                    </FluentButton>
                </FluentStack>
            }
            else if (Model.ThinkingMode == ThinkingMode.OnOff)
            {
                <FluentMessageBar Intent="MessageBarIntent.Info">
                    Reasoning for this model can be enabled or disabled.
                </FluentMessageBar>
            }

            @* Token configuration *@
            <h4 class="brand-text">Token configuration</h4>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
                    <FluentNumberInput Label="Context window"
                                       Step="1024"
                                       Style="width:100%;"
                                       @bind-Value="Model.ContextWindow" />
                    <FluentNumberInput Label="Max output tokens"
                                       Style="width:100%;"
                                       @bind-Value="Model.MaxOutputTokens" />
            </FluentStack>

            @* Default parameters *@
            <h4 class="brand-text">Default parameters</h4>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" >
                <FluentStack Orientation="Orientation.Vertical" >
                    <FluentNumberInput Label="Temperature"
                                       Step="0.1"
                                       Style="width:100%;"
                                       @bind-Value="Model.Temperature" />
                    <div class="brand-text">
                        Controls the randomness of generated responses.
                    </div>
                </FluentStack>
                <FluentStack Orientation="Orientation.Vertical">
                    <FluentNumberInput Label="Num Ctx"
                                       Step="1024"
                                       Style="width:100%;"
                                       @bind-Value="Model.NumCtx" />
                    <div class="brand-text">
                        Maximum model context window size.
                    </div>
                </FluentStack>
            </FluentStack>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
                <FluentStack Orientation="Orientation.Vertical">
                    <FluentNumberInput Label="Top P"
                                       Step="0.1"
                                       Style="width:100%;"
                                       @bind-Value="Model.TopP" />
                    <div class="brand-text">
                        Nucleus sampling probability threshold.
                    </div>
                </FluentStack>
                <FluentStack Orientation="Orientation.Vertical">
                    <FluentNumberInput Label="Top K"
                                       Style="width:100%;"
                                       @bind-Value="Model.TopK" />
                    <div class="brand-text">
                        Number of candidate tokens considered during sampling.
                    </div>
                </FluentStack>
            </FluentStack>
            <FluentCheckbox @bind-Value="Model.IsEnabled">
                Enabled
            </FluentCheckbox>
        </EditForm>
    </FluentStack>
</FluentDialogBody>

@code
{
    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public IReadOnlyList<AIProviderListItem> Providers { get; set; } = [];

    [Parameter]
    public AIModelEditModel Model { get; set; } = new();

    [CascadingParameter]
    public IDialogInstance? DialogInstance { get; set; }

    private EditContext _editContext = default!;
    private ValidationMessageStore _reasoningMessages = default!;
    private bool _validationAttempted;
    private bool _closing;

    private readonly IEnumerable<ThinkingMode> _thinkingModes = Enum.GetValues<ThinkingMode>();

    protected override void OnInitialized()
    {
        if (IsNew && Model.ProviderId <= 0 && Providers.Count > 0)
        {
            var provider = Providers[0];

            Model.ProviderId = provider.Id;
            Model.ProviderName = provider.Name;
        }

        _editContext = new EditContext(Model);
        _reasoningMessages = new ValidationMessageStore(_editContext);
        _editContext.OnValidationRequested += ValidateReasoning;
        _editContext.OnFieldChanged += FieldChanged;

        if (DialogInstance is not null)
        {
            DialogInstance.Options.Header.Title = IsNew ? "Add Model" : $"Edit {Model.DisplayName}";
            DialogInstance.Options.Header.CloseAction.Visible = true;
            DialogInstance.Options.Footer.PrimaryAction.Disabled = false;
            DialogInstance.Options.Footer.PrimaryAction.OnClickAsync = _ => SubmitAsync();
        }
    }

    private async Task SubmitAsync()
    {
        if (_closing) return;

        _validationAttempted = true;

        if (_editContext.Validate() && DialogInstance is not null)
        {
            _closing = true;
            await DialogInstance.CloseAsync();
        }
    }

    private void FieldChanged(object? sender, FieldChangedEventArgs args)
    {
        if (_validationAttempted)
        {
            _editContext.Validate();
        }
    }

    private void Revalidate()
    {
        if (_validationAttempted)
        {
            _editContext.Validate();
        }
    }

    private void ValidateReasoning(object? sender, ValidationRequestedEventArgs args)
    {
        _reasoningMessages.Clear();

        if (Model.ThinkingMode == ThinkingMode.Effort)
        {
            foreach (var effort in Model.ReasoningEfforts)
            {
                var results = new List<ValidationResult>();
                Validator.TryValidateObject(effort, new ValidationContext(effort), results, true);
                foreach (var result in results)
                {
                    foreach (var member in result.MemberNames)
                    {
                        _reasoningMessages.Add(new FieldIdentifier(effort, member), result.ErrorMessage!);
                    }
                }
            }

            var field = new FieldIdentifier(Model, nameof(Model.ReasoningEfforts));

            if (Model.ReasoningEfforts.Count == 0)
                _reasoningMessages.Add(field, "At least one reasoning effort is required.");
            if (Model.ReasoningEfforts.Count(x => x.IsDefault) != 1)
                _reasoningMessages.Add(field, "Exactly one reasoning effort must be the default.");
            if (Model.ReasoningEfforts.GroupBy(x => x.Value.Trim(), StringComparer.OrdinalIgnoreCase).Any(x => x.Count() > 1))
                _reasoningMessages.Add(field, "Reasoning effort values must be unique.");
        }

        _editContext.NotifyValidationStateChanged();
    }

    public void Dispose()
    {
        _editContext.OnValidationRequested -= ValidateReasoning;
        _editContext.OnFieldChanged -= FieldChanged;

        if (DialogInstance is not null)
            DialogInstance.Options.Footer.PrimaryAction.OnClickAsync = null;
    }

    private void AddEffort()
    {
        var nextSortOrder = Model.ReasoningEfforts.Count == 0
            ? 10
            : Model.ReasoningEfforts.Max(x => x.SortOrder) + 10;

        Model.ReasoningEfforts.Add(new ReasoningEffortEditModel
        {
            SortOrder = nextSortOrder,
            IsDefault = Model.ReasoningEfforts.Count == 0
        });

        Revalidate();
    }

    private void RemoveEffort(ReasoningEffortEditModel effort)
    {
        var wasDefault = effort.IsDefault;

        Model.ReasoningEfforts.Remove(effort);
        _validationAttempted = true;

        if (wasDefault && Model.ReasoningEfforts.Count > 0)
        {
            var newDefault = Model.ReasoningEfforts
                .OrderBy(x => x.SortOrder)
                .First();

            newDefault.IsDefault = true;
        }

        Revalidate();
    }

    private void SetDefaultEffort(ReasoningEffortEditModel effort, bool value)
    {
        if (!value)
        {
            effort.IsDefault = false;
            Revalidate();
            return;
        }

        foreach (var item in Model.ReasoningEfforts)
        {
            item.IsDefault = ReferenceEquals(item, effort);
        }

        Revalidate();
    }

    private bool IsReasoningValid()
    {
        if (Model.ThinkingMode != ThinkingMode.Effort) return true;

        return
            Model.ReasoningEfforts.Count > 0 &&
            Model.ReasoningEfforts.All(x => !string.IsNullOrWhiteSpace(x.DisplayName)) &&
            Model.ReasoningEfforts.All(x => !string.IsNullOrWhiteSpace(x.Value)) &&
            Model.ReasoningEfforts.Count(x => x.IsDefault) == 1;
    }

    private void ProviderChanged()
    {
        var provider = Providers.FirstOrDefault(x => x.Id == Model.ProviderId);

        Model.ProviderName = provider?.Name ?? string.Empty;

        Revalidate();
    }
}
